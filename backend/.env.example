# Copy to backend/.env for local runs (never commit the real file), or paste
# these into Render -> your service -> Environment.

# VTU Africa gateway (owner float). Never leaves the server.
VTU_API_KEY=

# Flutterwave: funding accounts, payouts and the webhook signature.
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_PUBLIC_KEY=

# Firebase Admin: verify app sign-ins and read/write Firestore wallets.
# Either the whole service-account JSON on one line, or a path to the file.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_PROJECT_ID=nationsub-84906

# Optional
# NATIONSB_LOG_REQUESTS=1
# LOG_LEVEL=INFO
# Local testing only: JSON ledger instead of Firestore, and skip sign-in checks.
# NATIONSB_WALLET_FILE=./.local-wallet.json
# NATIONSB_ALLOW_ANON=1
